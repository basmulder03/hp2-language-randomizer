+// LanguagePicker run statistics accessors. The tables are too large for
+// UnrealScript's 4KB context-expression limit, so LanguagePicker and the
+// stats page go through these instead of touching the arrays directly.
+// Table: 0 = line type (row = LanguagePicker.LT_*), 1 = speaker, 2 = level.
+function int LangStatNumRows(int Table)
+{
+  if ( Table == 0 )
+    return ArrayCount(LangStatsType);
+  if ( Table == 1 )
+    return ArrayCount(LangStatsSpeaker);
+  return ArrayCount(LangStatsLevel);
+}
+
+function string LangStatKey(int Table, int Row)
+{
+  if ( Table == 0 )
+    return LangStatsType[Row].Key;
+  if ( Table == 1 )
+    return LangStatsSpeaker[Row].Key;
+  return LangStatsLevel[Row].Key;
+}
+
+function int LangStatGet(int Table, int Row, int Lang)
+{
+  if ( Table == 0 )
+    return LangStatsType[Row].Count[Lang];
+  if ( Table == 1 )
+    return LangStatsSpeaker[Row].Count[Lang];
+  return LangStatsLevel[Row].Count[Lang];
+}
+
+function LangStatAdd(int Table, int Row, int Lang)
+{
+  if ( Table == 0 )
+    LangStatsType[Row].Count[Lang]++;
+  else if ( Table == 1 )
+    LangStatsSpeaker[Row].Count[Lang]++;
+  else
+    LangStatsLevel[Row].Count[Lang]++;
+}
+
+// Row for Key in a keyed table (1 or 2), claiming the first unused row if
+// it's new. When the table is full, the last row becomes a catch-all.
+function int LangStatRowFor(int Table, string Key)
+{
+  local int i, n;
+
+  n = LangStatNumRows(Table);
+  for ( i = 0; i < n; i++ )
+  {
+    if ( LangStatKey(Table, i) ~= Key )
+      return i;
+    if ( LangStatKey(Table, i) == "" )
+    {
+      if ( Table == 1 )
+        LangStatsSpeaker[i].Key = Key;
+      else
+        LangStatsLevel[i].Key = Key;
+      return i;
+    }
+  }
+  if ( Table == 1 )
+    LangStatsSpeaker[n - 1].Key = "OTHER";
+  else
+    LangStatsLevel[n - 1].Key = "OTHER";
+  return n - 1;
+}
+
+// LanguagePicker: randomize Harry's own cutscene and scripted lines (harry
+// is a PlayerPawn, so the HPawn override doesn't cover him).
+event SubstituteDialog(Sound InSound, String InTxt, out Sound Replacement, out String ReplacmentTxt)
+{
+	class'LanguagePicker'.static.SubstituteDialogHelper(InSound, InTxt, Replacement, ReplacmentTxt, "AllDialog", "HPdialog", self);
+}
