+// LanguagePicker: hidden redub pool toggle. "Redub" flips it, "Redub on" /
+// "Redub off" set it explicitly. Saved to the ini like the other settings.
+// LanguagePicker: replay the last subtitled line in another language.
+exec function ReplayLine ()
+{
+  local string L;
+  local string T;
+  local Sound S;
+
+  if ( !class'LanguagePicker'.static.PickReplay(L,S,T) )
+  {
+    ClientMessage("ReplayLine: nothing to replay yet");
+    return;
+  }
+  PlaySound(S,SLOT_Talk,1.4,,100000.0,,True);
+  MyHud.SetSubtitleText(T,GetSoundDuration(S));
+}
+
+exec function Redub (optional string OnOff)
+{
+  local bool b;
+
+  if ( OnOff ~= "on" || OnOff ~= "1" || OnOff ~= "true" )
+    b = True;
+  else if ( OnOff ~= "off" || OnOff ~= "0" || OnOff ~= "false" )
+    b = False;
+  else
+    b = !class'LanguagePicker'.static.IsRedubEnabled();
+  class'LanguagePicker'.static.SetRedubEnabled(b);
+  if ( b )
+    ClientMessage("Redub: ON");
+  else
+    ClientMessage("Redub: OFF");
+}
